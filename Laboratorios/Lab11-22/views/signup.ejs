<%- include('includes/_head', {
    title: 'Crear cuenta',
    css: 'style.css',
    bodyClass: 'grey lighten-4',
    useMaterialize: true
}) %>

<div class="container">
    <h3 class="center-align">Crear cuenta</h3>
    <div class="row">
        <form class="col s12" action="/usuarios/signup" method="POST" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="input-field">
                <input id="nombre" name="nombre" type="text">
                <label for="nombre">Nombre</label>
            </div>
            <div class="input-field">
                <input id="username" name="username" type="text" required>
                <label for="username">Nombre de usuario</label>
            </div>
            <div class="input-field">
                <input id="matricula" name="matricula" type="text">
                <label for="matricula">Matricula</label>
            </div>
            <div class="input-field">
                <input id="correo" name="correo" type="email">
                <label for="correo">Correo</label>
            </div>
            <div class="input-field">
                <input id="password" name="password" type="password" required>
                <label for="password">Contraseña</label>
            </div>
            <div class="file-field input-field">
                <div class="btn blue">
                    <span>Imagen</span>
                    <input id="foto" name="foto" type="file" accept=".png,.jpg,.jpeg">
                </div>
                <div class="file-path-wrapper">
                    <input class="file-path validate" type="text" placeholder="Sube una foto de perfil opcional">
                </div>
            </div>
            <p class="upload-hint">Solo se permiten imagenes PNG, JPG o JPEG.</p>
            <button class="btn green btn-space" type="submit">
                Crear cuenta
            </button>

            <a href="/usuarios/login" class="btn grey">
                Volver al login
            </a>
        </form>
    </div>
</div>
<%- include('includes/_footer') %>
